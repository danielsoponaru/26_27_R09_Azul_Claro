# ============================================
# DATOS — no se suben, estén donde estén
# Se mantiene la estructura de carpetas (Datos/, subcarpetas)
# gracias a los .gitkeep, pero no su contenido
# ============================================
**/Datos/**
!**/Datos/**/
!**/Datos/**/.gitkeep

# Por si alguien mete datos sueltos fuera de una carpeta Datos/,
# en cualquier subcarpeta del repo
**/*.csv
**/*.tsv
**/*.xlsx
**/*.xls
**/*.xlsm
**/*.parquet
**/*.feather
**/*.pkl
**/*.pickle
**/*.h5
**/*.hdf5
**/*.npz
**/*.npy
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.jsonl
**/*.ndjson

# ============================================
# Modelos entrenados / checkpoints (PyTorch)
# ============================================
**/*.pt
**/*.pth
**/*.ckpt

# ============================================
# Entornos y cachés de Python
# ============================================
.venv/
venv/
env/
**/__pycache__/
**/*.pyc
.pytest_cache/
**/.ipynb_checkpoints/

# ============================================
# Credenciales y secretos
# ============================================
**/*.pem
**/*.key
.env
.env.*

# ============================================
# Herramientas del curso (no forman parte de la entrega)
# ============================================
graphify-out/

# ============================================
# Editor / SO
# ============================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============================================
# Resultados generados por los scripts (no se suben)
# ============================================
outputs/*
!outputs/parametros_montecarlo.json

# ============================================
# Archivos Markdown (no se suben)
# ============================================
**/*.md
!**/README.md
desktop.ini
